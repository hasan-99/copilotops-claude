# ~/.claude/.claudeignore
# Patterns to exclude from Claude Code context

# Secrets and credentials
.env
.env.*
*.pem
*.key
credentials.json
*secret*
.credentials.json

# Node modules (anywhere)
skills/*/node_modules/
plugins/cache/*/node_modules/
node_modules/

# Large generated directories
.next/
dist/
build/
*.log

# Claude internals (prevent recursion/bloat)
plugins/cache/
shell-snapshots/
debug/
file-history/
projects/
archive/
todos/
session-env/
paste-cache/

# IDE and editor
.vscode/
.idea/

# History and state files
history.jsonl
*.jsonl
cleanup.log
