{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-6",
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SUDO_ASKPASS": "/home/qualia/.claude/askpass.sh"
  },
  "permissions": {
    "allow": [
      "Skill(dev-browser:dev-browser)",
      "Bash(npx tsx:*)",
      "Bash(find:*)",
      "Bash(sudo -A *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git push:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/branch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash(rm -rf:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/confirm-delete.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-env-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash(supabase db push:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/migration-validate.sh"
          }
        ]
      },
      {
        "matcher": "Bash(vercel --prod:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-deploy-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context-loader.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/speak.sh \"$CLAUDE_NOTIFICATION\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/save-session-state.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "dev-browser@dev-browser-marketplace": true,
    "supabase@claude-plugins-official": true
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/qualiasolutions"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "vapi": {
      "command": "npx",
      "args": [
        "-y",
        "@vapi-ai/mcp-server"
      ],
      "env": {
        "VAPI_TOKEN": "d616dd43-3770-452a-9337-526f392dc480"
      }
    },
    "telnyx_api": {
      "command": "telnyx-mcp-server",
      "args": [],
      "env": {
        "TELNYX_API_KEY": "KEY019ABFC802BE9DF48B26CB5E7DFEFD14_KsPeq4x6AJvz7D9ZjNMvxU",
        "TELNYX_MCP_TOOLS": "get_phone_number,get_message,list_assistants,mcp_telnyx_delete_assistant,get_assistant_texml,cloud_storage_list_buckets,list_embedded_buckets,get_webhook_events,start_assistant_call,send_message,make_call,hangup,speak,transfer,send_dtmf,playback_start,playback_stop"
      }
    },
    "elevenlabs": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/elevenlabs-mcp-server"
      ],
      "env": {
        "ELEVENLABS_API_KEY": "sk_7ed98c8dfe85842183561244ebc3e7120ac291b7005ec0ca"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash /home/qualia/.claude/statusline-command.sh"
  }
}