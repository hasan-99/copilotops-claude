# Claude Code Configuration
# Model aliases and quick skill shortcuts

# ============================================
# Model Aliases
# ============================================
# Usage: claude ~opus "your prompt"
# ============================================

alias ~haiku="--model claude-haiku-4-5-20251001"
alias ~sonnet="--model claude-sonnet-4-5-20250929"
alias ~opus="--model claude-opus-4-6"

# ============================================
# Quick Skill Aliases
# ============================================
# Usage: /fd to invoke frontend-master --design
# ============================================

# Frontend
alias /fd="/frontend-master --design"
alias /fb="/frontend-master --build"
alias /fm="/frontend-master --modernize"
alias /resp="/responsive"

# Debugging & Fixing
alias /dbg="/debug"
alias /dbf="/debug --frontend"
alias /dbp="/debug --perf"

# Review & Audit
alias /rv="/review"
alias /rw="/review --web"
alias /ra="/review --ai"
alias /dr="/deep-research"
alias /sr="/stack-researcher"

# Deploy
alias /dep="/deploy"
alias /dq="/deploy --quick"

# Voice & AI
alias /va="/voice-agent"

# Supabase
alias /sb="/supabase"
